{
  "name": "media-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "本地运行的 AI 原生口播编排工作台",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "mw": "./bin/mw.mjs"
  },
  "scripts": {
    "mw": "tsx src/cli/index.ts",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "studio": "remotion studio src/composition/index.ts",
    "fonts:fetch-test": "tsx scripts/fetch-test-fonts.ts",
    "fonts:check": "tsx scripts/check-fonts.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/captions": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/layout-utils": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/player": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "cac": "7.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "zod": "4.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
